                                        <VBox spacing="6.0">
                                            <children>
                                                <Label style="-fx-text-fill: #ECF0F1;" text="Recorrido:" />
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <ComboBox fx:id="cmbTraversalSimple" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="PostOrder" style="-fx-background-color: #0D1B4B; -fx-border-color: #1F3868;" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnPlaySimple" mnemonicParsing="false" prefHeight="35.0" styleClass="btn-accent" text="▶" />
                                                    </children>
                                                </HBox>
                                                <TextArea fx:id="txtAreaOutputSimple" editable="false" prefHeight="70.0" style="-fx-control-inner-background: #0D1B4B; -fx-text-fill: #2ECC71; -fx-border-color: #1F3868;" styleClass="steps-list" text="PostOrder: [3, 12, 5, 7, 12, 20, 10]" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <Separator prefWidth="200.0" style="-fx-opacity: 0.2;" />

                                        <VBox spacing="4.0">
                                            <children>
                                                <Label fx:id="lblStatsSimple" style="-fx-text-fill: #BDC3C7;" text="Nodos: 7  |  Altura: 2" />
                                                <Label fx:id="lblEliminadoSimple" style="-fx-text-fill: #2ECC71;" text="🗙 Eliminado: 15" />
                                            </children>
                                        </VBox>

